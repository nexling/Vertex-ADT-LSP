{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Vertex ADT",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#debug"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#vardeclares"
		}
		
	],
	"repository": {
		"debug": {
			"patterns": [{
				"name": "debug.line.vertexadt",
				"match": "^\\s*debug.*"
			}
			]
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.vertexadt",
				"match": "\\b(if|then|else|endif|loop|endloop|return|exitif|and|or)\\b"
			},
			{
				"name": "keyword.control.include.vertexadt",
				"match": "#\\s*include\\b"
			  },
			  {
				"name": "keyword.control.include.vertexadt",
				"match": "##\\s*included_from\\b"
			  },
			  {
				"name": "keyword.control.include.vertexadt",
				"match": "#\\s*attributes\\b"
			  },
			  {
				"name": "keyword.control.include.vertexadt",
				"match": "\\s*call\\b"
			  },
			  {
				"name": "keyword.commonon.vertexadt",
				"match": "\\b(common_indexes 1|common_dbases 1|common_elements 1|common_files 1|common_points 1|common_progressbars 1)\\b"
			  },
			  {
				"name": "keyword.commonoff.vertexadt",
				"match": "\\b(common_indexes 0|common_dbases 0|common_elements 0|common_files 0|common_points 0|common_progressbars 0)\\b"
			  },
			  {
				"name": "keyword.strsyntax.vertexadt",
				"match": "^\\s*charset=.*"
			  }
			]
		},
		"strings": {
			"patterns": [
				  {
					"name": "string.quoted.double.vertexadt",
					"begin": "\"",
					"end": "\"",
					"patterns": [
					  {
						"name": "constant.character.escape.vertexadt",
						"match": "\\\\."
					  },
					  {
						"name": "string.hash.vertexadt",
						"begin": "^###",
						"end": "###$"
					  }
					]
				  },
				  {
					"name": "string.hash.vertexadt",
					"begin": "^###",
					"end": "###$"
				  }
				
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.todo",
					"match": "^\\s*!.*TODO.*$"
				},
				{
					"name": "comment.line.problem",
					"match": "^\\s*!.*PROBLEM.*$"
				},
				{
					"name": "comment.line.temporary",
					"match": "^\\s*!.*TEMP.*$"
				},
				{
					"name": "comment.line.debug",
					"match": "^\\s*!.*DEBUG.*$"
				},
				{
					"name": "comment.line.debug",
					"match": ";\\s*!.*DEBUG.*$"
				},
				{
					"name": "comment.line.old",
					"match": "^\\s*!.*OLD.*$"
				},
				{
					"name": "comment.line.old",
					"match": ";\\s*!.*OLD.*$"
				},
				{
					"name": "comment.line.new",
					"match": "^\\s*!.*NEW.*$"
				},
				{
					"name": "comment.line.new",
					"match": ";\\s*!.*NEW.*$"
				},
				{
					"name": "comment.line.todo",
					"match": ";\\s*!.*TODO.*$"
				},
				{
					"name": "comment.line.problem",
					"match": ";\\s*!.*PROBLEM.*$"
				},
				{
					"name": "comment.line.temporary",
					"match": ";\\s*!.*TEMP.*$"
				},
				{
					"name": "comment.line.question",
					"match": "^\\s*!.*QUEST.*$"
				},
				{
					"name": "comment.line.question",
					"match": ";\\s*!.*QUEST.*$"
				},
				{
					"name": "comment.line.info",
					"match": "^\\s*!.*INFO.*$"
				},
				{
					"name": "comment.line.info",
					"match": ";\\s*!.*INFO.*$"
				},
				{
					"name": "comment.line.example",
					"match": "^\\s*!.*EXAMPLE.*$"
				},
				{
					"name": "comment.line.example",
					"match": ";\\s*!.*EXAMPLE.*$"
				},
				{
					"name": "comment.line.semicolon",
					"match": ";\\s*!.*"
				},
				{
					"name": "comment.line.exclamation",
					"match": "^\\s*!.*$"
				}
				
			]
		},
