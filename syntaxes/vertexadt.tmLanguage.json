				},
				{
					"name": "variable.Pvector.vertexadt",
					"match": "\\b[A-Za-z][A-Za-z0-9_]*P(\\d+)?\\b"
				},
				{
					"name": "variable.Nvector.vertexadt",
					"match": "\\b[A-Za-z][A-Za-z0-9_]*N(\\d+)?\\b"
				},
				{
					"name": "variable.Xvector.vertexadt",
