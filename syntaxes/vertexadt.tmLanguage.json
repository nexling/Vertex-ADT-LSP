				},
				{
					"name": "variable.Zvector.vertexadt",
					"match": "\\bZ(\\d+)?\\b"
				},
				{
					"name": "variable.Pvector.vertexadt",
					"match": "\\bP(\\d+)?\\b"
				},
				{
					"name": "variable.Nvector.vertexadt",
					"match": "\\bN(\\d+)?\\b"
				},
				{
					"name": "variable.other.vertexadt",
					"match": "\\b[A-Za-z][A-Za-z0-9_]*\\b(?!\\$)"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.semicolon.vertexadt",
					"match": ";"
				}
