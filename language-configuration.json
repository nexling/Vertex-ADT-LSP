{
    "comments": {
        // symbol used for single line comment. Remove this entry if your language does not support line comments
        "lineComment": "!"
    },
    // symbols used as brackets
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "folding": {
        "markers": {
            "start": "^##.*|^@declarationnumbercheckstart.*",
            "end": ".*##|@declarationnumbercheckend.*"
        }
    },
    // Block if (`then` last, before an optional `;` / `;!` comment), loop with
    // or without arguments, and else open a level. Case-sensitive (ADR 0010).
    "indentationRules": {
      "increaseIndentPattern": "^\\s*(if\\b[^;]*\\bthen|loop\\b[^;]*|else)\\s*(;.*)?$",
      "decreaseIndentPattern": "^\\s*(endif|endloop|else)\\b"
    },
    "wordPattern": "\\b\\w+\\$?"
}