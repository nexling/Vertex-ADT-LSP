{
    "comments": {
        // symbol used for single line comment. Remove this entry if your language does not support line comments
        "lineComment": "!"
    },
    // symbols used as brackets
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "folding": {
        "markers": {
            "start": "^##.*|^@declarationnumbercheckstart.*",
            "end": ".*##|@declarationnumbercheckend.*"
        }
    },
    "indentationRules": {
      "increaseIndentPattern": "^\\s*(if\\b.*\\bthen|loop)$",
      "decreaseIndentPattern": "^\\s*(endif|endloop)$",
      "unIndentedLinePattern": "^\\s*(else)$"
    },
    "wordPattern": "\\b\\w+\\$?"
}